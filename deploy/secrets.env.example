# Copy to keys/mainnet/secrets.env (chmod 600) and fill in. deploy/push-env.sh ships it to the box.
# Solana RPC with getProgramAccounts + getSignaturesForAddress (Helius). ⚠ burst limits: an earlier incident
RPC_URL=https://mainnet.helius-rpc.com/?api-key=
# @UseCashtags' numeric X id (the platform launch is accepted only from it) and the project ticker, without $
PLATFORM_X_ID=
PROJECT_TICKER=
PROJECT_NAME=
# Sign in with X: an X developer app, OAuth 2.0, callback https://cashtags.family/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# twitterapi.io: reading mentions (key) and replying as @UseCashtags (login cookie + residential proxy)
TWITTERAPI_IO_KEY=
X_LOGIN_COOKIE=
X_PROXY=
# FOMO wallet payouts (fomoapi:<key>), optional
FOMO_LOOKUP=
# X Money payouts via Peer (api/xmoney.mjs): 1 = on. Fund the Base wallet with a little ETH first
# (FEE_SEED_FILE=keys/mainnet/fee-seed.hex node api/xmoney-wallet.mjs prints it). BASE_RPC_URL optional.
XMONEY_ENABLED=
BASE_RPC_URL=
# Pinata JWT for coin metadata (pump.fun closed its uploader)
PINATA_JWT=
# Optional switches: BOT=0 stops the bot loop, REPLIES=0 stops replies, POLL_SECONDS (default 20)
# pre-made …cash mint keys kept in stock (each launch uses one; the box makes ~11 an hour)
VANITY_TARGET=300
